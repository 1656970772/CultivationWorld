    {
      "evidence_id": "ev-c7-001",
      "content": "金光穿透无数林木落向了地面，一颗璀璨夺目的金色珠子滚落到辰南的脚下，他将这一切看得清清楚楚，激动的蹲下身子，将金珠捡了起来。",
      "source_location": {
        "chunk_id": "chunk-0007",
        "source_range": [
          60,
          180
        ]
      },
      "confidence": "EXTRACTED",
      "verification_status": "verified",
